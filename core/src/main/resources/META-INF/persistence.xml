<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="iogurtesPU" transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!--
            À medida que criares as entidades JPA vais adicionando aqui
            Exemplo:
            <class>com.iogurtes.model.Iogurte</class>
        -->

        <properties>
            <!-- Ligação à BD -->
            <property name="jakarta.persistence.jdbc.driver"
                      value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:postgresql://localhost:5432/iogurtes_db"/>
            <property name="jakarta.persistence.jdbc.user"
                      value="postgres"/>
            <property name="jakarta.persistence.jdbc.password"
                      value="578999"/>

            <!-- Hibernate -->
            <property name="hibernate.hbm2ddl.auto"    value="update"/>
            <property name="hibernate.dialect"         value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.show_sql"        value="true"/>
            <property name="hibernate.format_sql"      value="true"/>
        </properties>

    </persistence-unit>

</persistence>